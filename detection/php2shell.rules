# php2shell-guard — Suricata / Snort IDS rules for CVE-2026-109618 / CVE-2026-109619
#
# Primary vector: a multipart POST body carrying the PHP_SESSION_UPLOAD_PROGRESS
# field. Legitimate traffic almost never contains this string in a request body,
# so it is a high-signal, low-noise indicator.
#
# SID range 9109600-9109699 is local/experimental — renumber to fit your ruleset.
# Test in IDS (alert) mode before switching any rule to drop/reject.

# --- 1. Core: upload_progress field in a POST body (the main attack string) ---
alert http any any -> $HTTP_SERVERS any (msg:"php2shell CVE-2026-109618/19 PHP_SESSION_UPLOAD_PROGRESS in POST body"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; nocase; classtype:web-application-attack; reference:cve,2026-109618; reference:cve,2026-109619; sid:9109600; rev:1;)

# --- 2. Combined with multipart content-type (tightens to the exploit shape) ---
alert http any any -> $HTTP_SERVERS any (msg:"php2shell multipart upload_progress abuse"; flow:established,to_server; http.method; content:"POST"; http.header; content:"multipart/form-data"; nocase; http.request_body; content:"PHP_SESSION_UPLOAD_PROGRESS"; nocase; classtype:web-application-attack; reference:cve,2026-109618; sid:9109601; rev:1;)

# --- 3. Recon: name="PHP_SESSION_UPLOAD_PROGRESS" form field (per rfc1867) ---
alert http any any -> $HTTP_SERVERS any (msg:"php2shell upload_progress form field present"; flow:established,to_server; http.request_body; content:"name=|22|PHP_SESSION_UPLOAD_PROGRESS|22|"; nocase; classtype:web-application-attack; reference:cve,2026-109619; sid:9109602; rev:1;)

# --- 4. Response-side: unexpected 502 burst can indicate OOM worker crashes ---
# Rate-based; tune threshold to your traffic. Informational, not an attack match.
alert http $HTTP_SERVERS any -> any any (msg:"php2shell possible OOM worker crash (502 burst)"; flow:established,to_client; http.stat_code; content:"502"; threshold:type threshold, track by_dest, count 30, seconds 60; classtype:web-application-activity; reference:cve,2026-109618; sid:9109603; rev:1;)

# --- 5. Common post-exploitation: webshell command params in a request ---
alert http any any -> $HTTP_SERVERS any (msg:"php2shell possible webshell interaction (cmd/exec param)"; flow:established,to_server; http.uri; pcre:"/[?&](cmd|exec|shell|system|c)=/i"; classtype:web-application-attack; reference:cve,2026-109618; sid:9109604; rev:1;)
